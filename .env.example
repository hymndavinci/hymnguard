# Optional. Without this key the email checker shows a "needs HIBP API key"
# state for the HIBP breach lookup (the other breach sources still run).
# Get a key at https://haveibeenpwned.com/API/Key (paid, from $4/mo).
HIBP_API_KEY=

# Optional. OsintCat API key for the OsintCat breach lookup.
# Without it the UI shows a needs-key state for that source.
# Get a key at https://www.osintcat.net (free tier includes searches on
# sign-up; breach lookup availability on the free tier is unconfirmed).
OSINTCAT_API_KEY=

# Optional. GitHub personal access token (no scopes needed) for the GitHub
# exposure check (searches public commits authored with the email).
# Without it the UI shows a needs-key state for that source.
GITHUB_TOKEN=

# Optional. AlienVault OTX API key for the OTX passive DNS source in the
# domain checker. Free tier at https://otx.alienvault.com (sign up, then
# copy the key from your profile page). Without it the UI shows a needs-key
# state for that source.
OTX_API_KEY=

# Optional. AbuseIPDB API key for the IP reputation check. Free tier
# (1,000 checks/day) at https://www.abuseipdb.com (sign up, then create a
# key under API). Without it the UI shows a needs-key state for reputation.
ABUSEIPDB_API_KEY=

# Optional. IPQualityScore API key for the phone carrier + risk check
# (carrier, line type, fraud score, active status, leak flag). Free tier
# at https://www.ipqualityscore.com (sign up for a free API key; phone
# validation free tier reported at 1,000 lookups/month). Without it the
# UI shows a needs-key state for carrier/risk; format, prefix, and spam
# reports still run.
IPQS_API_KEY=

# Optional, but BOTH are required to enable account enumeration.
# VERIFY_SECRET: any long random string, used to HMAC-sign the ownership
# verification tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
VERIFY_SECRET=

# RESEND_API_KEY: Resend API key for sending ownership-verification codes.
# Get one at https://resend.com (free tier available).
# RESEND_FROM: the sender address. Resend's free tier only allows sending
# from onboarding@resend.dev to the account owner's own email address —
# to send codes to arbitrary emails, verify a domain you own in Resend
# and set RESEND_FROM to an address on it (e.g. noreply@yourdomain.com).
RESEND_API_KEY=
RESEND_FROM=

# --- Accounts (Phase 5) ---
# Without DATABASE_URL the app runs exactly as before: all six checkers
# work anonymously, and sign-in reports "not configured". Set these to
# enable accounts (saved history, breach monitoring, BYOK).

# DATABASE_URL: Postgres connection string. Neon (free tier) is the
# recommended host: create a project at https://neon.tech, copy the
# pooled connection string, and paste it here (or as a Vercel env var).
# The schema is created automatically on the next build
# (scripts/db-push-if-configured.mjs). For local dev, any Postgres
# works, e.g. postgresql://hymnguard:password@127.0.0.1:5432/hymnguard
DATABASE_URL=

# SESSION_SECRET: any long random string, used to HMAC-sign session
# cookies. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ENCRYPTION_KEY: 64 hex characters (32 bytes), used to AES-256-GCM
# encrypt saved API keys and monitored emails at rest. Required for
# BYOK and breach monitoring. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this key makes previously stored keys and monitored
# emails undecryptable (they must be re-saved).
ENCRYPTION_KEY=

# CRON_SECRET: any long random string. Vercel Cron sends it as a Bearer
# token when calling /api/cron/monitor; the route refuses to run
# without a matching token. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Optional. VirusTotal API key for the hash + URL reputation checks
# (70+ engine verdicts). Free tier (500 req/day, 4/min) at
# https://www.virustotal.com. Without it both checkers show a needs-key
# state for VirusTotal; their free sources still run.
VIRUSTOTAL_API_KEY=<redacted>

# Optional. MalwareBazaar Auth-Key for the hash checker (abuse.ch
# sample database). Free at https://auth.abuse.ch. Without it the hash
# checker shows a needs-key state for MalwareBazaar.
MALWAREBAZAAR_API_KEY=<redacted>

# Optional. Hybrid Analysis API key for the hash checker (Falcon
# Sandbox verdicts). Free Public API key at
# https://www.hybrid-analysis.com. Without it the hash checker shows a
# needs-key state for Hybrid Analysis.
HYBRID_ANALYSIS_API_KEY=<redacted>

# Optional. Google Safe Browsing API key for the URL checker
# (malware / social-engineering / unwanted-software lists). Free tier
# (10,000 req/day) from Google Cloud Console. Without it the URL
# checker shows a needs-key state for Safe Browsing.
SAFE_BROWSING_API_KEY=<redacted>

# Optional. Etherscan API key for the wallet checker. One key covers
# Ethereum + BNB Chain (unified v2 API). Free tier at
# https://etherscan.io. Without it the wallet check reports
# "needs an Etherscan API key" — it has no other source.
ETHERSCAN_API_KEY=<redacted>
