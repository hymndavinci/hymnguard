# Optional. Without this key the email checker shows a "needs HIBP API key"
# state for the HIBP breach lookup (the other breach sources still run).
# Get a key at https://haveibeenpwned.com/API/Key (paid, from $4/mo).
HIBP_API_KEY=

# Optional. OsintCat API key for the OsintCat breach lookup.
# Without it the UI shows a needs-key state for that source.
# Get a key at https://www.osintcat.net (free tier includes searches on
# sign-up; breach lookup availability on the free tier is unconfirmed).
OSINTCAT_API_KEY=

# Optional. GitHub personal access token (no scopes needed) for the GitHub
# exposure check (searches public commits authored with the email).
# Without it the UI shows a needs-key state for that source.
GITHUB_TOKEN=

# Optional. AlienVault OTX API key for the OTX passive DNS source in the
# domain checker. Free tier at https://otx.alienvault.com (sign up, then
# copy the key from your profile page). Without it the UI shows a needs-key
# state for that source.
OTX_API_KEY=

# Optional. AbuseIPDB API key for the IP reputation check. Free tier
# (1,000 checks/day) at https://www.abuseipdb.com (sign up, then create a
# key under API). Without it the UI shows a needs-key state for reputation.
ABUSEIPDB_API_KEY=

# Optional. IPQualityScore API key for the phone carrier + risk check
# (carrier, line type, fraud score, active status, leak flag). Free tier
# at https://www.ipqualityscore.com (sign up for a free API key; phone
# validation free tier reported at 1,000 lookups/month). Without it the
# UI shows a needs-key state for carrier/risk; format, prefix, and spam
# reports still run.
IPQS_API_KEY=

# Optional, but BOTH are required to enable account enumeration.
# VERIFY_SECRET: any long random string, used to HMAC-sign the ownership
# verification tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
VERIFY_SECRET=

# RESEND_API_KEY: Resend API key for sending ownership-verification codes.
# Get one at https://resend.com (free tier available).
# RESEND_FROM: the sender address. Resend's free tier only allows sending
# from onboarding@resend.dev to the account owner's own email address —
# to send codes to arbitrary emails, verify a domain you own in Resend
# and set RESEND_FROM to an address on it (e.g. noreply@yourdomain.com).
RESEND_API_KEY=
RESEND_FROM=
